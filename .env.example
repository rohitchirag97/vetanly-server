# Copy to .env and fill in. The API and the root docker-compose.yml (database, Redis, server) all read this file.

# PostgreSQL. Changing user, password or database later does not alter an existing data volume.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vetanly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vetanly

# Redis. Generate a password with: openssl rand -hex 32
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# API
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Generate with: openssl rand -hex 64
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# 32-byte key (64 hex chars) for encrypting bank account numbers. Back it up: losing it makes stored numbers unreadable.
BANK_ENCRYPTION_KEY=

# Optional integrations
GOOGLE_CLIENT_ID=

# Email
RESEND_API_KEY=

EMAIL_FROM=

# Vetanly WhatsApp service (your separate project). Leave empty to only log messages.
VETANLY_WHATSAPP_URL=
VETANLY_WHATSAPP_API_KEY=
# Shared secret your service signs status callbacks with (HMAC-SHA256).
VETANLY_WHATSAPP_WEBHOOK_SECRET=
# apitxt SMS login codes until WhatsApp is set up. Leave empty locally so testing uses no credits.
SMS_API_AUTH_KEY=

# R2 (Cloudflare)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Platform Billing Information
PLATFORM_BILLING_NAME=
PLATFORM_BILLING_ADDRESS=
PLATFORM_BILLING_GSTIN=
PLATFORM_BILLING_EMAIL=

# Google Play review access (optional). Create a kiosk in a demo organization, put its id here and pick
# two 6-digit codes. Reviewers pair with the pairing code and unlock Enroll/Settings with the enrollment code;
# neither expires or is used up. Clear all three once the app is approved.
KIOSK_REVIEW_KIOSK_ID=
KIOSK_REVIEW_PAIRING_CODE=
KIOSK_REVIEW_ENROLLMENT_CODE=
